# =========================================================================
# Cyber Cell - Official Website Environment Variables (.env.example)
# Copy this file to .env.local and populate the values for your environment.
# =========================================================================

# Firebase Authentication & Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cyber-cell-d0258.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cyber-cell-d0258
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cyber-cell-d0258.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=100344904262
NEXT_PUBLIC_FIREBASE_APP_ID=1:100344904262:web:your_app_id_here

# Admin Panel & Certificate Studio Master Password
ADMIN_PASSWORD=Cybercell$123
ADMIN_SECRET_KEY=Cybercell$123

# Cloudinary Storage (Free 25GB CDN Cloud Storage - No Credit Card Required)
# Option A: Single Connection URL from Dashboard:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option B: Individual Variables:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
